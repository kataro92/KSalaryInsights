{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "KVSalaryToolsRulesetSchema",
 "description": "JSON Schema kiểm thử tính hợp lệ của bộ tham số luật versioned cho KVSalaryTools",
 "type": "object",
 "required": [
 "id",
 "version",
 "name",
 "tax_year",
 "effective_from",
 "effective_to",
 "legal_sources",
 "personal_relief",
 "dependent_relief",
 "reference_salary",
 "regional_minimum_wages",
 "insurance_rates",
 "insurance_caps",
 "pit_brackets"
 ],
 "properties": {
 "id": { "type": "string", "minLength": 1 },
 "version": { "type": "string", "minLength": 1 },
 "name": { "type": "string", "minLength": 1 },
 "tax_year": { "type": "integer", "minimum": 2020, "maximum": 2030 },
 "effective_from": { "type": "string", "format": "date" },
 "effective_to": { "type": "string", "format": "date" },
 "legal_sources": {
 "type": "array",
 "items": { "type": "string", "minLength": 1 },
 "minItems": 1
 },
 "personal_relief": { "type": "number", "minimum": 0 },
 "dependent_relief": { "type": "number", "minimum": 0 },
 "reference_salary": { "type": "number", "minimum": 0 },
 "regional_minimum_wages": {
 "type": "object",
 "required": ["1", "2", "3", "4"],
 "properties": {
 "1": { "type": "number", "minimum": 0 },
 "2": { "type": "number", "minimum": 0 },
 "3": { "type": "number", "minimum": 0 },
 "4": { "type": "number", "minimum": 0 }
 },
 "additionalProperties": false
 },
 "insurance_rates": {
 "type": "object",
 "required": ["employee", "employer"],
 "properties": {
 "employee": {
 "type": "object",
 "required": ["social", "health", "unemployment"],
 "properties": {
 "social": { "type": "number", "minimum": 0, "maximum": 1 },
 "health": { "type": "number", "minimum": 0, "maximum": 1 },
 "unemployment": { "type": "number", "minimum": 0, "maximum": 1 }
 },
 "additionalProperties": false
 },
 "employer": {
 "type": "object",
 "required": ["social", "health", "unemployment"],
 "properties": {
 "social": { "type": "number", "minimum": 0, "maximum": 1 },
 "health": { "type": "number", "minimum": 0, "maximum": 1 },
 "unemployment": { "type": "number", "minimum": 0, "maximum": 1 },
 "occupational_accident": { "type": "number", "minimum": 0, "maximum": 1 }
 },
 "additionalProperties": false
 }
 },
 "additionalProperties": false
 },
 "insurance_caps": {
 "type": "object",
 "required": ["social_health_multiplier", "unemployment_multiplier"],
 "properties": {
 "social_health_multiplier": { "type": "number", "minimum": 1 },
 "unemployment_multiplier": { "type": "number", "minimum": 1 }
 },
 "additionalProperties": false
 },
 "pit_brackets": {
 "type": "array",
 "minItems": 1,
 "items": {
 "type": "object",
 "required": ["bracket", "rate"],
 "properties": {
 "bracket": { "type": "integer", "minimum": 1 },
 "max_taxable_income": { "type": ["number", "null"], "minimum": 0 },
 "rate": { "type": "number", "minimum": 0, "maximum": 1 }
 },
 "additionalProperties": false
 }
 },
 "casual_income": {
 "type": "object",
 "description": "Optional. chỉ bắt buộc khi ruleset dùng cho module vãng lai (spec 004/008). Ruleset MVP 001–003 có thể bỏ qua; engine fallback: withholding_threshold=2_000_000 (trước 2026-07) / 5_000_000 (từ kỳ 2026 theo NĐ 253), withholding_rate=0.10, exemption_settlement_monthly_avg=15_000_000.",
 "required": [
 "withholding_threshold",
 "withholding_rate",
 "exemption_settlement_monthly_avg"
 ],
 "properties": {
 "withholding_threshold": { "type": "number", "minimum": 0 },
 "withholding_rate": { "type": "number", "minimum": 0, "maximum": 1 },
 "exemption_settlement_monthly_avg": { "type": "number", "minimum": 0 }
 },
 "additionalProperties": false
 }
 },
 "additionalProperties": false
}
