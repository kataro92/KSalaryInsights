{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KVSalaryToolsRulesetSchema",
  "description": "JSON Schema kiểm thử tính hợp lệ của bộ tham số luật versioned cho KVSalaryTools",
  "type": "object",
  "required": [
    "id",
    "version",
    "name",
    "tax_year",
    "effective_from",
    "effective_to",
    "legal_sources",
    "personal_relief",
    "dependent_relief",
    "reference_salary",
    "regional_minimum_wages",
    "insurance_rates",
    "insurance_caps",
    "pit_brackets"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "tax_year": { "type": "integer", "minimum": 2020, "maximum": 2030 },
    "effective_from": { "type": "string", "format": "date" },
    "effective_to": { "type": "string", "format": "date" },
    "legal_sources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "personal_relief": { "type": "number", "minimum": 0 },
    "dependent_relief": { "type": "number", "minimum": 0 },
    "reference_salary": { "type": "number", "minimum": 0 },
    "regional_minimum_wages": {
      "type": "object",
      "required": ["1", "2", "3", "4"],
      "properties": {
        "1": { "type": "number", "minimum": 0 },
        "2": { "type": "number", "minimum": 0 },
        "3": { "type": "number", "minimum": 0 },
        "4": { "type": "number", "minimum": 0 }
      }
    },
    "insurance_rates": {
      "type": "object",
      "required": ["employee", "employer"],
      "properties": {
        "employee": {
          "type": "object",
          "required": ["social", "health", "unemployment"],
          "properties": {
            "social": { "type": "number" },
            "health": { "type": "number" },
            "unemployment": { "type": "number" }
          }
        },
        "employer": {
          "type": "object",
          "required": ["social", "health", "unemployment"],
          "properties": {
            "social": { "type": "number" },
            "health": { "type": "number" },
            "unemployment": { "type": "number" }
          }
        }
      }
    },
    "insurance_caps": {
      "type": "object",
      "required": ["social_health_multiplier", "unemployment_multiplier"],
      "properties": {
        "social_health_multiplier": { "type": "number", "minimum": 1 },
        "unemployment_multiplier": { "type": "number", "minimum": 1 }
      }
    },
    "pit_brackets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bracket", "rate"],
        "properties": {
          "bracket": { "type": "integer" },
          "max_taxable_income": { "type": ["number", "null"] },
          "rate": { "type": "number" }
        }
      }
    },
    "casual_income": {
      "type": "object",
      "properties": {
        "withholding_threshold": { "type": "number" },
        "withholding_rate": { "type": "number" },
        "exemption_settlement_monthly_avg": { "type": "number" }
      }
    }
  }
}
